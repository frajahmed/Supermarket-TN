{
  "expo": {
    "name": "Supermarket TN",
    "slug": "supermarket-tn",
    "version": "0.1.0",
    "scheme": "supermarket-tn",
    "orientation": "default",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Supermarket TN uses the camera to scan product barcodes and delivery notes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
