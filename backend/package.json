{
  "name": "@warenwirtschaft/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API für Warenwirtschaft & Kasse – läuft auf dem lokalen Server je Kunde",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:core": "node --test \"test-core/**/*.test.ts\"",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test:integration": "node --test dist/backend/src/test/inventory.int.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@nestjs/websockets": "^10.4.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.0",
    "socket.io-client": "^4.8.0"
  }
}
